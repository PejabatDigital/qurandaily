{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qurandaily",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },

  // The built app (npm run build → dist/). Only /api/* runs Worker code; everything else
  // is served straight from assets, and unknown paths fall back to index.html so
  // client-side routes work.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Sign-in settings. The secrets BETTER_AUTH_SECRET and RESEND_API_KEY are set with
  // `npx wrangler secret put …` (or .dev.vars locally), never here.
  "vars": {
    "BETTER_AUTH_URL": "https://qurandaily.kasahkod.cc"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "qurandaily-production", "database_id": "f17557cf-3927-41cf-9bb2-62fa36ad8138", "migrations_dir": "migrations" }
  ]
}
